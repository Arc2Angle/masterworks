{
    "type": "masterworks:abstract",
    "components": [
        "blade",
        "guard",
        "handle"
    ],
    "roles": {
        "masterworks:item": {
            "blade": "masterworks:sword/blade",
            "guard": "masterworks:sword/guard",
            "handle": "masterworks:sword/handle"
        }
    },
    "properties": {
        "masterworks:durability": "$blade + $handle + $guard",
        "masterworks:attack_damage": "$blade",
        "masterworks:attack_speed": "$blade * 0.4 + $handle * 0.4 + $guard * 0.2"
    }
}