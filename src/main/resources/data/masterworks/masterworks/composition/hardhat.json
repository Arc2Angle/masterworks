{
    "type": "masterworks:abstract",
    "components": [
        "webbing",
        "shell",
        "lining"
    ],
    "roles": {
        "masterworks:item": {
            "webbing": "masterworks:elastic_webbing/head",
            "shell": "masterworks:rigid_shell/head",
            "lining": "masterworks:malleable_lining/head"
        },
        "masterworks:layer": {
            "webbing": "masterworks:head/elastic_webbing",
            "shell": "masterworks:head/rigid_shell",
            "lining": "masterworks:head/malleable_lining"
        }
    },
    "properties": {
        "masterworks:equipment_slot": "head",
        "masterworks:durability": "$webbing * 0.6 + $shell * 0.3 + $lining * 0.1",
        "masterworks:armor": "$webbing * 0.2 + $shell * 0.7 + $lining * 0.1",
        "masterworks:toughness": "$webbing * 0.1 + $shell * 0.4 + $lining * 0.5"
    }
}